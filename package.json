{
	"name": "uxc.integration",
	"version": "1.0.0",
	"description": "SAP UI5 Web Components Seamless Integration",
	"author": "SAP SE",
	"license": "Apache-2.0",
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "ui5 build --clean-dest",
		"build:opt": "ui5 build self-contained --clean-dest --all",
		"start": "ui5 serve --port 8080 -o index.html",
		"start:dist": "npm start -- --config ui5-dist.yaml",
		"ts-typecheck": "tsc --noEmit",
		"lint": "eslint webapp",
		"ui5lint": "ui5lint"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@openui5/types": "^1.153.0",
		"@ui5/cli": "^4.0.71",
		"@ui5/linter": "^1.23.7",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"rimraf": "^6.1.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"ui5-middleware-livereload": "^3.4.0",
		"ui5-test-runner": "^6.0.1",
		"ui5-tooling-modules": "3.41.3",
		"ui5-tooling-transpile": "^3.14.0"
	},
	"dependencies": {
		"@ui5/webcomponents": "^2.28.1",
		"@ui5/webcomponents-fiori": "^2.28.1",
		"@ui5/webcomponents-icons": "^2.28.0"
	}
}
